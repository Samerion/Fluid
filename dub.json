{
	"subConfigurations": {
		"bindbc-freetype": "staticBC"
	},
	"authors": [
		"Artha"
	],
	"lflags-windows": [
		"/LIBPATH:$PACKAGE_DIR/libraries/windows"
	],
	"lflags-linux": [
		"-L$PACKAGE_DIR/libraries/ubuntu"
	],
	"subPackages": [
		"./tour",
		{
			"sourceFiles": [
				"source/fluid/dub_template.d"
			],
			"sourcePaths": [],
			"targetType": "executable",
			"versions": [
				"Fluid_InitExec"
			],
			"targetPath": "build",
			"name": "init-exec"
		}
	],
	"license": "BSL",
	"targetPath": "build",
	"copyright": "Copyright © 2021–2024, Artha",
	"stringImportPaths": [
		"resources"
	],
	"name": "fluid",
	"libs": [
		"freetype"
	],
	"description": "Flexible, declarative library for graphical user interfaces (GUI, UI)",
	"dependencies": {
		"raylib-d": {
			"default": true,
			"version": "~>5.0",
			"optional": true
		},
		"diode": "~>0.9.0",
		"bindbc-freetype": "~>1.1.1",
		"elemi": {
			"version": "~>1.2.2",
			"optional": true
		},
		"bindbc-loader": "~>1.1.3",
		"arsd-official:image_files": {
			"version": "~>11.5.3",
			"optional": true
		},
		"optional": "~>1.3.0"
	},
	"copyFiles-windows": [
		"$PACKAGE_DIR/libraries/windows/freetype.dll",
		"$PACKAGE_DIR/libraries/windows/raylib.dll"
	],
	"buildTypes": {
		"serve-docs": {
			"sourceFiles": [
				"resources/theme.ddoc"
			],
			"buildOptions": [
				"syntaxOnly"
			],
			"versions": [
				"Fluid_Docs"
			],
			"dflags": [
				"-Dddocs",
				"-op",
				"-X",
				"-Xf=docs.json"
			],
			"postBuildCommands": [
				"sed -i.bak 's:href=\"docs/:href=\"/docs/:g' *docs/source/fluid/**.html",
				"$DUB run servefolder -- -d \"$PACKAGE_DIR\""
			]
		},
		"docs": {
			"sourceFiles": [
				"resources/theme.ddoc"
			],
			"buildOptions": [
				"syntaxOnly"
			],
			"versions": [
				"Fluid_Docs"
			],
			"dflags": [
				"-Dddocs",
				"-op",
				"-X",
				"-Xf=docs.json"
			],
			"postBuildCommands": [
				"sed -i.bak 's:href=\"docs/:href=\"/docs/:g' *docs/source/fluid/**.html"
			]
		}
	},
	"configurations": [
		{
			"targetType": "staticLibrary",
			"name": "default"
		},
		{
			"targetType": "sourceLibrary",
			"name": "source"
		},
		{
			"platforms": [
				"linux"
			],
			"dflags-ldc": [
				"--link-defaultlib-shared"
			],
			"targetType": "dynamicLibrary",
			"dflags-posix-dmd": [
				"-defaultlib=libphobos2.so"
			],
			"name": "linux-dynamic"
		},
		{
			"sourceFiles": [
				"tools/silly.d"
			],
			"versions": [
				"Fluid_HeadlessOutput",
				"Fluid_TestSpace",
				"Fluid_SVG"
			],
			"dflags": [
				"-verrors=0"
			],
			"name": "unittest",
			"sourcePaths": [
				"tests",
				"source"
			],
			"libs": [
				"raylib"
			],
			"dependencies": {
				"elemi": "~>1.2.2",
				"arsd-official:image_files": "~>11.5.3"
			},
			"targetType": "library",
			"importPaths": [
				"tests",
				"tools",
				"source"
			]
		},
		{
			"dflags-ldc": [
				"--ftime-trace",
				"--ftime-trace-file=build/trace.json"
			],
			"targetType": "library",
			"name": "time-trace"
		}
	],
	"lflags-osx": [
		"-L$PACKAGE_DIR/libraries/macos"
	]
}
